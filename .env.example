# PostgreSQL
POSTGRES_DB=newssummary
POSTGRES_USER=newssummary
POSTGRES_PASSWORD=newssummary

# Redis
# (デフォルト設定で動作)

# JWT
JWT_SECRET=change-me-in-production-at-least-32-chars
JWT_EXPIRATION_MS=86400000

# GCP (ai-summary-engine スペックで使用)
GCP_PROJECT_ID=your-gcp-project-id
GCP_LOCATION=us-central1
GEMINI_MODEL_NAME=gemini-1.5-pro

# Mail (notification-delivery スペックで使用)
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@newssummary.local
